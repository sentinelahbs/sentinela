# Segredos — nunca commitar
backend/.env
.env

# Gerado pelo assistente de configuração (setup_wizard.py) -- tem chave
# da loja e senha do DVR em texto puro, é config de instalação de cada
# loja, não código
edge-detection/box_config.json

# Python
backend/app/__pycache__/
backend/app/**/__pycache__/
edge-detection/__pycache__/
*.pyc
edge-detection/.venv/
backend/.venv/

# Modelos de detecção (arquivos grandes — baixados sob demanda, não versionados)
edge-detection/models/*.onnx
edge-detection/*.pt

# Codec H.264 (Cisco OpenH264) — baixado sob demanda, ver README
edge-detection/openh264*.dll

# Clipes gravados localmente em teste (saída, não código)
edge-detection/clips/

# Base local do correlator (ver correlator.py) — estado de runtime da box, não código
edge-detection/correlator.db*

# Logs por câmera do supervisor (ver supervisor.py) — saída de runtime, não código
edge-detection/logs/

# Node / Vite
dashboard/node_modules/
dashboard/dist/

# Bundle da box (Python embarcável + deps + NSSM) -- gerado por
# edge-detection/packaging/build.ps1, centenas de MB (o zip final
# sozinho passa do limite de 100MB do GitHub), nunca versionado. Rode
# o build.ps1 pra gerar de novo quando precisar.
edge-detection/packaging/dist/

# Configuração local do Claude Code (específica desta máquina)
.claude/settings.local.json

# Sistema
.DS_Store
Thumbs.db

# Zip original (conteúdo já extraído no repositório)
files.zip

.vercel
.env*
