DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lossprevention
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Deixe "false" — o schema é criado por `alembic upgrade head` (ver
# migrations/). "true" só é útil como atalho de teste bem pontual, antes
# de gerar a primeira migração.
AUTO_CREATE_TABLES=false

# Domínios com permissão de chamar a API (separados por vírgula).
# Obrigatório, e nunca "*" -- o backend recusa subir sem isso (CORS é a
# única barreira contra roubo de sessão entre sites, já que os cookies
# usam SameSite=None). Em desenvolvimento local, aponte pra origem do
# dashboard rodando localmente (ex: http://localhost:5173).
ALLOWED_ORIGINS=https://app.suaempresa.com.br

# Cookie de sessão (JWT em cookie HttpOnly). Em produção deixe "none" com
# Secure=true (necessário se algum painel rodar num domínio separado da
# API — pro navegador isso é cross-site). Em dev local, troque para
# COOKIE_SAMESITE=lax e COOKIE_SECURE=false (dev roda em http://, sem TLS).
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Storage de clipes (compatível com S3 — AWS, Cloudflare R2, Backblaze B2 etc.)
CLIPS_BUCKET=lossprevention-clips
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Envio de email transacional (convites de equipe).
# Exemplo usando SendGrid como relay SMTP — troque pelo seu provedor.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
EMAIL_FROM=naoresponda@suaempresa.com.br
EMAIL_FROM_NAME=VigIA

# URL do dashboard web publicado — usada para montar o link do convite
# e o link de redefinição de senha (painel de clientes)
APP_BASE_URL=http://localhost:5173
# URL do painel administrativo interno publicado — usada para montar o
# link de redefinição de senha quando o pedido vem de lá
ADMIN_BASE_URL=http://localhost:5174

# Cloudflare Turnstile (CAPTCHA) — Secret Key do widget criado em
# dash.cloudflare.com -> Turnstile. Sem essa variável definida, a
# verificação é pulada (não bloqueia) — útil só pra dev local.
TURNSTILE_SECRET_KEY=

# Quantos hops de proxy confiáveis existem na frente da API (cada um
# anexando uma entrada ao header X-Forwarded-For) -- usado por
# get_client_ip() em app/rate_limit.py pro rate limiting de
# login/signup/reset de senha/checkout e pro IP relatado ao Turnstile.
# Default 1: cobre todo caminho de deploy documentado no DEPLOY.md (o
# edge da Railway/Render/Fly, ou o proxy reverso self-managed rodando
# no mesmo host/rede — ver o binding em 127.0.0.1 no
# docker-compose.yml). Se você tiver mais de um proxy na frente da API
# (ex: CDN + load balancer + reverse proxy), aumente esse número de
# acordo — cada hop confiável extra soma +1.
TRUSTED_HOP_COUNT=1

# Cobrança via Pix (Asaas). Use a sandbox até testar tudo, troque para
# a URL de produção só quando for cobrar de verdade.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Token que você mesmo define no painel do Asaas (Configurações > Webhooks)
# e cola aqui — usado para validar que o webhook realmente veio de lá.
ASAAS_WEBHOOK_TOKEN=
